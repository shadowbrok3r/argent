[Unit]
Description=argent live studio (photoreal jewelry renders, :8790)
After=network-online.target

[Service]
ExecStart=%h/.local/bin/argent --priority low serve --port 8790 --library %h/argent/assets,%h/argent/library --out %h/argent/out/studio
Restart=on-failure
RestartSec=10
Nice=10
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
